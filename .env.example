# Copy to .env for local runs (never commit .env). In production these are GitHub Actions secrets/variables.
# --- secrets ---
POLAR_ACCESS_TOKEN=        # Polar organization access token: subscriptions:read, orders:read
SMTP_USER=                 # free Gmail address used to send alerts ($0, 500/day)
SMTP_PASS=                 # its 16-character Google app password (needs 2-Step Verification)
RESEND_API_KEY=            # optional alternative to SMTP; needs a domain you own
# --- non-secret settings ---
POLAR_SERVER=sandbox       # sandbox | production
POLAR_DOMAIN_FIELD=domain  # slug of the checkout custom field holding the customer's domain
SITE_URL=https://mailauth-watch.pages.dev
PORTAL_URL=https://polar.sh/your-org/portal
MAIL_FROM="MailAuth Watch <yourbrand.alerts@gmail.com>"   # must be the SMTP_USER address
MAX_EMAILS_PER_RUN=90      # Gmail allows 500/day, Resend free 100/day
MAX_DOMAINS=300
# --- public, baked into the static site by `npm run build:config` ---
PUBLIC_CHECKOUT_URL=       # Polar checkout link, e.g. https://buy.polar.sh/polar_cl_...
PUBLIC_PRICE_LABEL=$5
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
